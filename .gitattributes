# Siempre LF: los sha256 de las metadatas (data/*.meta.json, predicción congelada)
# se calculan sobre los bytes del archivo y no deben depender del sistema operativo.
*.py       text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.geojson  text eol=lf
*.csv      text eol=lf
*.md       text eol=lf
# Scripts de shell: con CRLF fallan en Linux/Mac
*.sh       text eol=lf
