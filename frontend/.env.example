NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo demo: token del botón Disparar reporte (igual a SIM_TOKEN del backend). Queda visible en el navegador;
# nunca poner aquí ADMIN_TOKEN.
