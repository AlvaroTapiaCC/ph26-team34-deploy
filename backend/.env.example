# Copiar a backend/.env (no se commitea). En Render, cargar las mismas variables.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://xxxx.supabase.co
# Supabase → Project Settings → API Keys (publishable y secret)
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=photos
# Supabase → Connect → Connection String → Session pooler
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# elevenlabs.io → API Keys (opcional)
ELEVENLABS_API_KEY=

# Protege endpoints administrativos (/formula/recompute). Vacío = abiertos.
ADMIN_TOKEN=

# Orígenes permitidos, separados por coma (en producción, la URL de Vercel)
CORS_ORIGINS=*
